[bandit]
# Exclude directories that shouldn't be scanned for security issues
exclude_dirs = archived_docs,archived_removal,archived_unused,phase4_removed_files_backup,one-off-test-debug-folder,node_modules,.pytest_cache,tests,examples

# Skip test IDs that produce false positives
skips = B101,B601,B110

# Focus on medium and high severity issues only
severity = medium
