Balance parallel test shards by MEASURED runtime, not test count.

WHAT
    Teaches frappe's ParallelTestRunner to read <app>/<pkg>/tests/test_timings.json
    and weight each test file by its measured runtime when splitting work across
    shards. Without it the runner balances by test COUNT plus a small hardcoded
    TEST_WEIGHT_OVERRIDES table, so one shard carrying the slow integration modules
    decides the whole job's wall clock.

    The timings table it reads is verenigingen/tests/test_timings.json, which IS
    committed. Only this runner change lives outside the app.

STATUS - READ THIS BEFORE ASSUMING IT WORKS
    As of 2026-08-06 this patch does NOT run in CI. .github/actions/setup/action.yml
    clones ${frappe-user}/frappe, and _base-server-tests.yml defaults frappe-user to
    'frappe', so CI builds against pristine upstream and shards by the stock
    heuristic. Until it is applied in the workflow (or merged upstream), its only
    effect is on `bench run-parallel-tests` run locally on a bench where someone has
    applied it by hand.

    It was extracted from an UNCOMMITTED working-tree modification in apps/frappe -
    one `git checkout` from being lost, with no copy anywhere. That is why it is here.

APPLY
    git -C apps/frappe apply apps/verenigingen/scripts/frappe-parallel-test-weights.patch

    Generated against frappe v16.19.0. Re-check it after a frappe upgrade: it touches
    parallel_test_runner.py, which upstream does change.

diff --git a/frappe/parallel_test_runner.py b/frappe/parallel_test_runner.py
index 7f57e54618..ea43d4352a 100644
--- a/frappe/parallel_test_runner.py
+++ b/frappe/parallel_test_runner.py
@@ -27,6 +27,33 @@ TEST_WEIGHT_OVERRIDES = {
 	"test_commands.py": 10,
 }
 
+# Cache of measured per-file weights, keyed by app package dir.
+_MEASURED_WEIGHTS_CACHE = {}
+
+
+def _get_measured_weights(file_name):
+	"""Load <app>/<pkg>/tests/test_timings.json for the file's app, if present.
+
+	Returns a {dotted.module.path: weight} dict (empty when the table is absent).
+	This is the "stats from previous test runs" lever hinted at above: an app can
+	ship a timings table so parallel shards balance by measured runtime instead of
+	raw test count. Results are cached per app package dir.
+	"""
+	try:
+		root, after = file_name.split("/apps/", 1)
+		app, pkg = after.split("/", 2)[:2]
+	except ValueError:
+		return {}
+	base = f"{root}/apps/{app}/{pkg}"
+	if base not in _MEASURED_WEIGHTS_CACHE:
+		path = os.path.join(base, "tests", "test_timings.json")
+		try:
+			with open(path) as f:
+				_MEASURED_WEIGHTS_CACHE[base] = json.load(f)
+		except (OSError, ValueError):
+			_MEASURED_WEIGHTS_CACHE[base] = {}
+	return _MEASURED_WEIGHTS_CACHE[base]
+
 
 class ParallelTestRunner:
 	def __init__(self, app, site, build_number=1, total_builds=1, dry_run=False, lightmode=False):
@@ -153,9 +180,25 @@ class ParallelTestRunner:
 
 	@staticmethod
 	def get_test_weight(test):
-		"""Get approximate count of tests inside a file"""
+		"""Approximate runtime weight of a test file for shard balancing.
+
+		Prefer measured per-file weights from <app>/<pkg>/tests/test_timings.json
+		(a {dotted.module.path: seconds-equivalent} table produced from prior
+		runs) so shards are balanced by *time* rather than raw ``def test_``
+		count. Falls back to the count-based heuristic when no table/entry exists.
+		"""
 		file_name = "/".join(test)
 
+		measured = _get_measured_weights(file_name)
+		if measured:
+			try:
+				after = file_name.split("/apps/", 1)[1]
+				dotted = ".".join(after.split("/")[1:])[: -len(".py")]
+			except IndexError:
+				dotted = None
+			if dotted in measured:
+				return measured[dotted]
+
 		test_weight = TEST_WEIGHT_OVERRIDES.get(test[-1]) or 1
 
 		with open(file_name) as f:
@@ -165,22 +208,26 @@ class ParallelTestRunner:
 
 
 def split_by_weight(work, weights, chunk_count):
-	"""Roughly split work by respective weight while keep ordering."""
-	expected_weight = sum(weights) // chunk_count
+	"""Balance work across chunks by weight using LPT bin-packing.
 
+	Assign each task (heaviest first) to the currently-lightest chunk. This
+	balances total weight per chunk far better than a single in-order greedy
+	pass, which dumps the remainder into the last chunk whenever heavy items
+	cluster together (e.g. alphabetically adjacent slow suites). Within each
+	chunk the tasks are re-sorted to their original order for predictability.
+	"""
 	chunks = [[] for _ in range(chunk_count)]
+	chunk_weights = [0] * chunk_count
 
-	chunk_no = 0
-	chunk_weight = 0
-
-	for task, weight in zip(work, weights, strict=False):
-		if chunk_weight > expected_weight:
-			chunk_weight = 0
-			chunk_no += 1
-			assert chunk_no < chunk_count
+	# Heaviest first; ties broken by original index so the split is deterministic.
+	order = sorted(range(len(work)), key=lambda i: (-weights[i], i))
+	for i in order:
+		c = min(range(chunk_count), key=lambda b: chunk_weights[b])
+		chunks[c].append(work[i])
+		chunk_weights[c] += weights[i]
 
-		chunks[chunk_no].append(task)
-		chunk_weight += weight
+	for chunk in chunks:
+		chunk.sort()
 
 	assert len(work) == sum(len(chunk) for chunk in chunks)
 	assert len(chunks) == chunk_count
