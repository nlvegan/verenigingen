{
    "framework_app_prefixes": [
        "frappe.",
        "erpnext.",
        "hrms.",
        "payments."
    ],
    "framework_methods": [
        "frappe.client.get",
        "frappe.client.get_list",
        "frappe.client.get_count",
        "frappe.client.get_value",
        "frappe.client.get_single",
        "frappe.client.get_single_value",
        "frappe.client.set_value",
        "frappe.client.insert",
        "frappe.client.insert_many",
        "frappe.client.save",
        "frappe.client.submit",
        "frappe.client.cancel",
        "frappe.client.delete",
        "frappe.client.get_api",
        "frappe.client.get_js",
        "frappe.client.reportview",
        "frappe.client.run_doc_method",
        "frappe.client.validate_link",
        "frappe.desk.form.utils.get_linked_docs",
        "frappe.desk.form.utils.get_sidebar_stats",
        "frappe.desk.search.search_link",
        "frappe.desk.search.search_widget",
        "frappe.desk.notifications.get_notifications",
        "frappe.desk.desktop.get_desk_sidebar_items",
        "frappe.desk.query_report.export_query",
        "frappe.desk.reportview.export_query",
        "frappe.core.doctype.file.file.get_attached_files",
        "frappe.handler.uploadfile",
        "frappe.utils.print_format.download_pdf",
        "frappe.core.doctype.communication.email.make",
        "run_doc_method"
    ],
    "http_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS",
        "HEAD"
    ],
    "payment_methods": [
        "ideal",
        "directdebit",
        "bancontact",
        "belfius",
        "creditcard",
        "paypal",
        "sofort",
        "kbc",
        "eps",
        "giropay",
        "przelewy24",
        "Bank Transfer",
        "SEPA Direct Debit",
        "Direct Debit",
        "Cash",
        "Credit Card",
        "Wire Transfer",
        "Mollie",
        "iDEAL"
    ],
    "excluded_patterns": [
        "node_modules",
        ".git",
        "dist",
        "build",
        "__pycache__",
        ".pytest_cache",
        ".mypy_cache",
        "eslint-plugins"
    ],
    "excluded_file_patterns": [
        "*.min.js",
        "*.bundle.js",
        "*.map",
        "*.spec.js",
        "*.test.js",
        "test_*.js"
    ],
    "excluded_js_directories": [
        "tests/",
        "test/",
        "eslint-plugins/",
        "cypress/",
        "playwright/"
    ],
    "ignore_method_patterns": [
        "^[A-Z]+$",
        "^[A-Z][a-z]+$"
    ],
    "ignore_method_names": [
        "Mollie",
        "DigiD",
        "bitcoin",
        "Manual",
        "Invalid Method",
        "Active",
        "Pending",
        "Approved",
        "Rejected",
        "Suspended",
        "Terminated",
        "Deceased",
        "Banned"
    ],
    "severity_rules": {
        "test_methods": "ignore",
        "api_methods": "medium",
        "core_methods": "high"
    },
    "test_file_patterns": [
        "test",
        "spec",
        "mock",
        "fixture",
        "cypress",
        "playwright"
    ]
}
