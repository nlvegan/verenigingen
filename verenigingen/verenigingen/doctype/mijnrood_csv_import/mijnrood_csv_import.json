  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "MEMBER-IMPORT-.YYYY.-",
      "reqd": 1
    },
    {
      "fieldname": "settings_instructions",
      "fieldtype": "HTML",
      "label": "Configuration Required",
      "options": "<div class=\"alert alert-warning\" style=\"margin-bottom: 15px;\">\n<h6><i class=\"fa fa-exclamation-triangle\"></i> Before Starting Import</h6>\n<p>Please configure the membership type mappings in <a href=\"/app/verenigingen-settings\" target=\"_blank\"><b>Verenigingen Settings</b></a>:</p>\n<ul>\n<li><b>CSV Monthly Membership Type</b> - Used for rows with \"Maandelijks\" payment period</li>\n<li><b>CSV Annual Membership Type</b> - Used for rows with \"Jaarlijks\" payment period</li>\n<li><b>CSV Quarterly Membership Type</b> (optional) - Used for rows with \"Kwartaal\" payment period</li>\n</ul>\n<p>The import will not start until these settings are configured.</p>\n</div>"
    },
    {
      "description": "Upload your CSV or Excel file with member data",
      "fieldname": "csv_file",
      "fieldtype": "Attach",
      "label": "CSV/Excel File",
      "reqd": 1
    },
    {
      "default": "utf-8",
      "fieldname": "encoding",
      "fieldtype": "Select",
      "label": "File Encoding",
      "options": "utf-8\nutf-8-sig\niso-8859-1\nwindows-1252",
      "reqd": 1
    },
    {
      "fieldname": "column_break_4",
      "fieldtype": "Column Break"
    },
    {
      "allow_on_submit": 1,
      "fieldname": "import_status",
      "fieldtype": "Select",
      "label": "Import Status",
      "options": "\nPending\nValidating\nReady for Import\nQueued\nIn Progress\nCompleted\nFailed",
      "read_only": 1
    },
    {
      "default": "0",
      "description": "Import only the first 25 rows to verify import settings are correct before running a full import",
      "fieldname": "test_mode",
      "fieldtype": "Check",
      "label": "Test Mode (First 25 Rows Only)"
    },
    {
      "collapsible": 1,
      "fieldname": "user_account_section",
      "fieldtype": "Section Break",
      "label": "User Account Creation"
    },
    {
      "default": "0",
      "description": "Automatically create chapters if they don't exist. New chapters will be assigned to the region specified in 'Default Region' field.",
      "fieldname": "auto_create_chapters",
      "fieldtype": "Check",
      "label": "Auto-create Chapters"
    },
    {
      "depends_on": "eval:doc.auto_create_chapters == 1",
      "description": "Region to assign to auto-created chapters. This region must exist before import. If not specified, import will attempt to create a default Netherlands region.",
      "fieldname": "default_region",
      "fieldtype": "Link",
      "label": "Default Region for New Chapters",
      "options": "Region"
    },
    {
      "default": "1",
      "description": "Create portal user accounts for imported members. This allows them to login and access self-service features.",
      "fieldname": "create_user_accounts",
      "fieldtype": "Check",
      "label": "Create User Accounts"
    },
    {
      "default": "0",
      "description": "Create volunteer records for imported members. Enable this if your CSV import should automatically create Volunteer records for all members.",
      "fieldname": "create_volunteer_records",
      "fieldtype": "Check",
      "label": "Create Volunteer Records"
    },
    {
      "default": "0",
      "description": "Create Employee records for members to enable expense claim functionality.",
      "fieldname": "create_employee_records",
      "fieldtype": "Check",
      "label": "Create Employee Records (for expense claiming)"
    },
    {
      "default": "0",
      "depends_on": "eval:doc.create_user_accounts == 1",
      "description": "Send welcome emails to newly created user accounts with login instructions",
      "fieldname": "send_welcome_emails",
      "fieldtype": "Check",
      "label": "Send Welcome Emails"
    },
    {
      "collapsible": 1,
      "fieldname": "performance_section",
      "fieldtype": "Section Break",
      "label": "Performance Options"
    },
    {
      "default": "1",
      "description": "Use safe member creation optimizations (~20-25% fewer database queries through metadata caching). This is safe and recommended.",
      "fieldname": "use_safe_optimization",
      "fieldtype": "Check",
      "label": "Use Safe Performance Optimization"
    },
    {
      "collapsible": 1,
      "fieldname": "section_break_mapping",
      "fieldtype": "Section Break",
      "label": "Field Mapping Guide"
    },
    {
      "fieldname": "field_mapping_instructions",
      "fieldtype": "HTML",
      "label": "Expected CSV/Excel Column Headers",
      "options": "<div class=\"alert alert-info\">\n<h6>Expected CSV Format:</h6>\n<p>Your CSV should contain the following columns (Dutch headers are automatically mapped):</p>\n<ul>\n<li><strong>Lidnr.</strong> → Member ID</li>\n<li><strong>Voornaam</strong> → First Name</li>\n<li><strong>Achternaam</strong> → Last Name</li>\n<li><strong>Geboortedatum</strong> → Birth Date (YYYY-MM-DD)</li>\n<li><strong>Inschrijfdataum</strong> → Member Since (YYYY-MM-DD)</li>\n<li><strong>Groep</strong> → Chapter/Group</li>\n<li><strong>E-mailadres</strong> → Email</li>\n<li><strong>Telefoonnr.</strong> → Phone Number</li>\n<li><strong>Adres</strong> → Address</li>\n<li><strong>Plaats</strong> → City</li>\n<li><strong>Postcode</strong> → Postal Code</li>\n<li><strong>Landcode</strong> → Country Code</li>\n<li><strong>IBAN</strong> → Bank Account</li>\n<li><strong>Contributiebedrag</strong> → Membership Fee (creates dues schedule with override reason \"Import from mijnrood\")</li>\n<li><strong>Betaalperiode</strong> → Payment Period (determines billing frequency and membership type)</li>\n<li><strong>Mollie CID</strong> → Mollie Customer ID</li>\n<li><strong>Mollie SID</strong> → Mollie Subscription ID</li>\n<li><strong>Lidmaatschapstype</strong> → Member Status Type:\n  <ul>\n    <li>'Lid' → Active member</li>\n    <li>'Overleden' → Deceased member</li>\n    <li>'Opgezegd' → Terminated (voluntarily cancelled)</li>\n    <li>'Uitgeschreven' → Terminated (voluntarily left)</li>\n    <li>'Geroyeerd' → Banned (expelled for cause)</li>\n    <li>'Geschorst' → Suspended</li>\n    <li>'Dubbel' → Rejected (duplicate entry)</li>\n  </ul>\n</li>\n</ul>\n</div>"
    },
    {
      "depends_on": "eval:doc.import_status == 'Ready for Import'",
      "fieldname": "preview_section",
      "fieldtype": "Section Break",
      "label": "Data Preview"
    },
