      "options": "\nPending\nValidating\nReady for Import\nQueued\nIn Progress\nCompleted\nFailed",
      "read_only": 1
    },
    {
      "default": "0",
      "description": "Import only the first 25 rows to verify import settings are correct before running a full import",
      "fieldname": "test_mode",
