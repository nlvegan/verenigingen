{
  "app": "verenigingen",
  "autoname": "format:BATCH-{YY}-{MM}-{####}",
  "creation": "2023-01-01 00:00:00.000000",
  "doctype": "DocType",
  "engine": "InnoDB",
  "field_order": [
    "batch_details_section",
    "batch_date",
    "batch_description",
    "batch_type",
    "sequence_type",
    "column_break_5",
    "total_amount",
    "currency",
    "entry_count",
    "status",
    "approval_section",
    "approval_status",
    "risk_level",
    "column_break_approval",
    "approval_notes",
    "approved_by",
    "approved_on",
    "related_bank_transactions",
    "validation_section",
    "validation_status",
    "validation_errors",
    "validation_warnings",
    "invoices_section",
    "invoices",
    "sepa_file_section",
    "generate_sepa_file",
    "sepa_file_generated",
    "sepa_file",
    "column_break_15",
    "sepa_message_id",
    "sepa_payment_info_id",
    "sepa_generation_date",
    "section_break_19",
    "batch_log"
  ],
  "fields": [
    {
      "fieldname": "batch_details_section",
      "fieldtype": "Section Break",
      "label": "Batch Details"
    },
    {
      "default": "Today",
      "fieldname": "batch_date",
      "fieldtype": "Date",
      "label": "Batch Date",
      "reqd": 1
    },
    {
      "fieldname": "batch_description",
      "fieldtype": "Data",
      "label": "Batch Description",
      "reqd": 1
    },
    {
      "default": "CORE",
      "description": "SEPA scheme / local instrument (pain.008 LclInstrm). Not the sequence type.",
      "fieldname": "batch_type",
      "fieldtype": "Select",
      "label": "Batch Type (Scheme)",
      "options": "CORE\nB2B\nCOR1",
      "reqd": 1
    },
    {
      "default": "RCUR",
      "description": "SEPA sequence type (pain.008 SeqTp): FRST (first), RCUR (recurring), FNAL (final), OOFF (one-off).",
      "fieldname": "sequence_type",
      "fieldtype": "Select",
      "label": "Sequence Type",
      "options": "FRST\nRCUR\nFNAL\nOOFF"
    },
    {
      "fieldname": "column_break_5",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "total_amount",
      "fieldtype": "Currency",
      "label": "Total Amount",
      "options": "currency",
      "read_only": 1
    },
    {
      "default": "EUR",
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency",
      "reqd": 1
    },
    {
      "fieldname": "entry_count",
      "fieldtype": "Int",
      "label": "Entry Count",
      "read_only": 1
    },
    {
      "default": "Draft",
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nGenerated\nSubmitted\nProcessed\nPartially Failed\nFailed\nRolled Back",
      "read_only": 1,
      "allow_on_submit": 1
    },
    {
      "fieldname": "approval_section",
      "fieldtype": "Section Break",
      "label": "Approval Workflow"
    },
    {
      "default": "Pending Approval",
      "fieldname": "approval_status",
      "fieldtype": "Select",
      "label": "Approval Status",
      "options": "Pending Approval\nPending Senior Approval\nApproved\nRejected",
      "read_only": 1,
      "allow_on_submit": 1
    },
    {
      "default": "Low",
      "fieldname": "risk_level",
      "fieldtype": "Select",
      "label": "Risk Level",
      "options": "Low\nMedium\nHigh\nCritical",
      "read_only": 1,
      "allow_on_submit": 1
    },
    {
      "fieldname": "column_break_approval",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "approval_notes",
      "fieldtype": "Long Text",
      "label": "Approval Notes",
      "allow_on_submit": 1
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Link",
      "label": "Approved By",
      "options": "User",
      "read_only": 1,
      "allow_on_submit": 1
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": 1,
      "allow_on_submit": 1
    },
    {
      "description": "Bank transaction references related to this batch",
      "fieldname": "related_bank_transactions",
      "fieldtype": "Long Text",
      "label": "Related Bank Transactions"
    },
    {
      "fieldname": "validation_section",
      "fieldtype": "Section Break",
      "label": "Sequence Type Validation"
    },
    {
      "fieldname": "validation_status",
      "fieldtype": "Select",
      "label": "Validation Status",
      "options": "Passed\nWarnings\nCritical Errors\nValidation Failed",
      "read_only": 1,
      "allow_on_submit": 1
    },
    {
      "fieldname": "validation_errors",
      "fieldtype": "Long Text",
      "label": "Critical Errors",
      "read_only": 1,
      "depends_on": "eval:doc.validation_status == 'Critical Errors' || doc.validation_status == 'Validation Failed'"
    },
    {
      "fieldname": "validation_warnings",
      "fieldtype": "Long Text",
      "label": "Warnings",
      "read_only": 1,
      "depends_on": "eval:doc.validation_status == 'Warnings' || doc.validation_errors"
    },
    {
      "fieldname": "invoices_section",
      "fieldtype": "Section Break",
      "label": "Invoices"
    },
    {
      "fieldname": "invoices",
      "fieldtype": "Table",
      "label": "Invoices",
      "options": "Direct Debit Batch Invoice"
    },
    {
      "fieldname": "sepa_file_section",
      "fieldtype": "Section Break",
      "label": "SEPA File"
    },
    {
      "fieldname": "generate_sepa_file",
      "fieldtype": "Button",
      "label": "Generate SEPA File"
    },
    {
      "default": "0",
      "fieldname": "sepa_file_generated",
      "fieldtype": "Check",
      "label": "SEPA File Generated",
      "read_only": 1,
      "allow_on_submit": 1
    },
    {
      "depends_on": "eval:doc.sepa_file_generated==1",
      "fieldname": "sepa_file",
      "fieldtype": "Attach",
      "label": "SEPA File"
    },
    {
      "fieldname": "column_break_15",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "sepa_message_id",
      "fieldtype": "Data",
      "label": "SEPA Message ID",
      "read_only": 1
    },
    {
      "fieldname": "sepa_payment_info_id",
      "fieldtype": "Data",
      "label": "SEPA Payment Info ID",
      "read_only": 1
    },
    {
      "fieldname": "sepa_generation_date",
      "fieldtype": "Datetime",
      "label": "SEPA Generation Date",
      "read_only": 1
    },
    {
      "fieldname": "section_break_19",
      "fieldtype": "Section Break",
      "label": "Batch Log"
    },
    {
      "fieldname": "batch_log",
      "fieldtype": "Long Text",
      "label": "Batch Log",
      "read_only": 1
    }
  ],
  "is_submittable": 1,
  "modified": "2026-06-15 12:30:00.000000",
